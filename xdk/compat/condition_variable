// The part of C++11 <condition_variable> that NooDS uses (VS2010 has none):
// wait_for with a predicate. It checks the predicate every millisecond, so
// notify_one/notify_all have nothing to do.
#pragma once

#include <chrono>
#include <mutex>

namespace std {

class condition_variable {
public:
    void notify_one() {}
    void notify_all() {}

    template <typename Lock, typename Rep, typename Period, typename Predicate>
    bool wait_for(Lock &lock, const chrono::duration<Rep, Period> &timeout, Predicate predicate) {
        const long long limit = xds::clockMicroseconds() +
            chrono::microseconds(timeout).count();
        while (!predicate()) {
            if (xds::clockMicroseconds() >= limit) return predicate();
            lock.unlock();
            xds::sleepMilliseconds(1);
            lock.lock();
        }
        return true;
    }
};

} // namespace std
